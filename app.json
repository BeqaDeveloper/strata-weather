{
  "expo": {
    "name": "Strata Weather",
    "slug": "strata-weather",
    "version": "1.1.0",
    "orientation": "portrait",
    "description": "Weather, in perspective. Two forecast sources with a distinctive atmospheric experience.",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.beqadeveloper.strataweather",
      "supportsTablet": true
    },
    "android": {
      "package": "com.beqadeveloper.strataweather",
      "adaptiveIcon": {
        "backgroundColor": "#121C18",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-font"]
  }
}
